# Copy to supabase/.env to enable "Sign in with Google" on the LOCAL Supabase
# stack (npx supabase start). Never commit supabase/.env.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI for local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
