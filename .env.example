# Copy this file to .env for `npm start` (never commit .env).
# Leave both empty to run the offline demo.
#
# Supabase dashboard → your project → Connect (or Project Settings → API):
#   SUPABASE_URL       the project URL, https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY  the anon / publishable key. NOT the service-role / secret key.
#
# Against the local stack (`npm run db:start`), use the API_URL and
# PUBLISHABLE_KEY that `npx supabase status` prints.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PORT=3000
